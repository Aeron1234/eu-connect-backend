NODE_ENV=production
TZ=Asia/Manila
PORT=7000
CLIENT_URL=https://eu-connect.example.edu
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eu_connect
DB_USER=REPLACE_RUNTIME_DB_USER
DB_PASSWORD=REPLACE_RUNTIME_DB_PASSWORD
ACCESS_TOKEN_SECRET=REPLACE_WITH_SHARED_ACCESS_SECRET
REFRESH_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_REFRESH_SECRET
TEMP_PASSWORD_SECRET=REPLACE_WITH_DIFFERENT_TEMP_SECRET
# Current runtime still requires these until chapter 09 is implemented.
# A filesystem root setting is not supported by the current backend.
SUPABASE_URL=https://REPLACE_PROJECT.supabase.co
SUPABASE_KEY=REPLACE_SERVER_ONLY_STORAGE_KEY
SUPABASE_BUCKET=REPLACE_PRIVATE_BUCKET
EMAILJS_SERVICE_ID=REPLACE_SERVICE_ID
EMAILJS_TEMPLATE_ID=REPLACE_ACCOUNT_SETUP_TEMPLATE
EMAILJS_DTR_TEMPLATE_ID=REPLACE_DUTY_REMINDER_TEMPLATE
EMAILJS_PUBLIC_KEY=REPLACE_EMAILJS_PUBLIC_KEY
EMAILJS_PRIVATE_KEY=REPLACE_EMAILJS_PRIVATE_KEY
MAX_SHIFT_HOURS=10
# Optional defaults/tuning
CACHE_ENABLED=true
BATCH_SIZE=100
REFRESH_TOKEN_REVOKED_RETENTION_DAYS=1
REFRESH_TOKEN_CLEANUP_BATCH_SIZE=1000
# Optional map overrides
# MAP_ORIGIN_LAT=13.9304557
# MAP_ORIGIN_LNG=121.4312752
# MAP_ROUTING_BASE_URL=https://routing.openstreetmap.de/routed-car/

